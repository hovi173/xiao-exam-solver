# =========================================================================
# KONFIGURACJA ŚRODOWISKA - XIAO CLOUD SOLVER
# =========================================================================

# Port nasłuchiwania kontenera / serwera (Render domyślnie przekazuje własny PORT)
PORT=5000
HOST=0.0.0.0

# Tryb pracy:
# true  = Tryb makiety testowej (0 zł, błyskawiczne KaTeX i SVG bez zużycia tokenów)
# false = Tryb produkcyjny API Claude (wymaga poprawnego ANTHROPIC_API_KEY)
MOCK_MODE=true

# Klucz do API Anthropic (Claude 3.5 / 5.5)
ANTHROPIC_API_KEY=twoj_klucz_sk-ant-...

# Modele AI
OCR_MODEL=claude-haiku-5-5
SOLVER_MODEL=claude-opus-5-5
